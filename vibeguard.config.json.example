{
  "enabled": true,
  "debug": false,
  "placeholder_prefix": "__VG_",
  "session": {
    "ttl": "1h",
    "max_mappings": 100000,
    "max_sessions": 50
  },
  "patterns": {
    "keywords": [
      { "value": "my-api-key-123", "category": "API_KEY" }
    ],
    "regex": [
      { "pattern": "my-internal-token-[0-9]+", "category": "INTERNAL_TOKEN" }
    ],
    "builtin": ["secrets", "email", "uuid"],
    "exclude": ["example.com", "localhost", "127.0.0.1", "0.0.0.0"],
    "max_text_chars": 500000,
    "min_secret_len": 8,
    "protected_files": [
      "/home/user/.config/myapp/token",
      "/home/user/project/.env"
    ],
    "import_deny_paths": true,
    "deny_policy": ""
  }
}
